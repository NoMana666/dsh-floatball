{
  "name": "dsh-floatball",
  "version": "1.0.0",
  "type": "module",
  "description": "A desktop floating ball for DeepSeek Harness: shows peak/valley pricing, starts with DSH, exits with it, and blinks when an approval is waiting.",
  "license": "MIT",
  "author": "NoMana-",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "floating-ball",
    "desktop",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_NAME/dsh-floatball.git"
  },
  "homepage": "https://github.com/YOUR_GITHUB_NAME/dsh-floatball#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "ball.ps1",
    "layered.cs.txt",
    "menu.cs.txt",
    "assets",
    "locale",
    "docs",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
